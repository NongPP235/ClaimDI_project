# Postgres connection. On Vercel use the Supabase "Transaction pooler" URI
# (port 6543). Leave unset locally to use the built-in data/pglite database.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Optional: CA certificate (PEM) to verify the database TLS certificate.
# DATABASE_CA=
# Set the exact public HTTPS origin when deployed behind a proxy.
# APP_ORIGIN=https://your-app.example
